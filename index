<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Anime Opinion</title>
<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="apple-touch-icon" href="data:image/png;base64,">
<style>
:root{
  --bg:#080810;
  --surface:#0f0f1a;
  --surface2:#141422;
  --border:#1e1e32;
  --border2:#252540;
  --accent:#a78bfa;
  --accent-dim:#4c3d8f;
  --accent-glow:rgba(167,139,250,0.15);
  --gold:#f59e0b;
  --gold-dim:#78450a;
  --text:#e2e2f0;
  --text-muted:#5a5a80;
  --text-dim:#3a3a58;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--bg);font-family:'DM Sans',system-ui,sans-serif;color:var(--text);min-height:100vh;}

/* subtle noise grain overlay */
body::before{
  content:'';
  position:fixed;inset:0;z-index:0;pointer-events:none;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='1'/%3E%3C/svg%3E");
  opacity:0.03;
}

/* HERO */
.hero{
  position:relative;width:100%;height:320px;overflow:hidden;
  display:flex;align-items:flex-end;
  background:var(--bg);
}
/* animated gradient mesh */
.hero-bg{
  position:absolute;inset:0;
  background:
    radial-gradient(ellipse 80% 60% at 20% 50%, rgba(88,28,220,0.28) 0%, transparent 60%),
    radial-gradient(ellipse 60% 80% at 80% 20%, rgba(245,158,11,0.12) 0%, transparent 55%),
    radial-gradient(ellipse 50% 50% at 60% 80%, rgba(139,92,246,0.18) 0%, transparent 50%);
  animation:heroShift 12s ease-in-out infinite alternate;
}
@keyframes heroShift{
  0%{background-position:0% 50%,100% 0%,50% 100%;}
  100%{background-position:30% 70%,80% 30%,60% 60%;}
}
.hero-overlay{
  position:absolute;inset:0;
  background:linear-gradient(to bottom, transparent 30%, rgba(8,8,16,0.6) 70%, var(--bg) 100%);
}
/* decorative horizontal line */
.hero::after{
  content:'';position:absolute;bottom:0;left:0;right:0;height:1px;
  background:linear-gradient(90deg,transparent,rgba(167,139,250,0.4),transparent);
}
.hero-text{position:relative;z-index:1;padding:0 28px 32px;}
.hero-eyebrow{
  font-size:10px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;
  color:var(--accent);margin-bottom:10px;opacity:0.8;
}
.hero-title{
  font-family:'Bebas Neue',sans-serif;
  font-size:64px;line-height:0.95;color:#fff;letter-spacing:2px;
  text-shadow:0 0 60px rgba(139,92,246,0.4),0 4px 30px rgba(0,0,0,0.9);
}
.hero-sub{font-size:12px;color:var(--text-muted);margin-top:10px;font-weight:400;letter-spacing:.02em;}

/* BODY */
.body{padding:0 20px 80px;max-width:1200px;margin:0 auto;position:relative;z-index:1;}

/* FILTERS ROW */
.filters-row{display:flex;align-items:flex-start;gap:8px;flex-wrap:wrap;padding:22px 0 4px;}
.filters{display:flex;flex-wrap:wrap;gap:6px;}

.pill{
  padding:5px 15px;border-radius:999px;font-size:11px;font-weight:500;
  cursor:pointer;border:1px solid var(--border2);background:var(--surface);
  color:var(--text-muted);transition:all .2s;user-select:none;letter-spacing:.02em;
}
.pill:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-glow);}
.pill.active{
  background:var(--accent-glow);border-color:var(--accent);color:var(--accent);
  box-shadow:0 0 12px var(--accent-glow);
}

/* RECOMMEND BUTTON */
.rec-btn{
  display:flex;align-items:center;gap:6px;margin-left:auto;
  padding:6px 16px;border-radius:999px;font-size:11px;font-weight:500;
  cursor:pointer;border:1px solid var(--accent-dim);
  background:rgba(76,61,143,0.2);color:var(--accent);
  transition:all .2s;white-space:nowrap;letter-spacing:.02em;
}
.rec-btn:hover{background:rgba(76,61,143,0.4);border-color:var(--accent);box-shadow:0 0 16px var(--accent-glow);}
.rec-btn svg{width:13px;height:13px;fill:none;stroke:currentColor;stroke-width:1.8;}

/* SECTION LABELS */
.section-label{
  display:flex;align-items:center;gap:12px;
  font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;
  margin:36px 0 14px;
}
.section-label::after{content:'';flex:1;height:1px;background:var(--border);}
.section-label.lbl-t5{color:var(--gold);}
.section-label.lbl-t5::after{background:linear-gradient(90deg,var(--gold-dim),transparent);}
.section-label.lbl-t10{color:#c48a1a;}
.section-label.lbl-t10::after{background:linear-gradient(90deg,#3a2800,transparent);}
.section-label.lbl-good{color:#34d399;}
.section-label.lbl-good::after{background:linear-gradient(90deg,#0d3327,transparent);}
.section-label.lbl-meh{color:#6b7280;}
.section-label.lbl-meh::after{background:linear-gradient(90deg,#1f2028,transparent);}
.section-label.lbl-trash{color:#f87171;}
.section-label.lbl-trash::after{background:linear-gradient(90deg,#2d1010,transparent);}
.section-label.lbl-want{color:var(--accent);}
.section-label.lbl-want::after{background:linear-gradient(90deg,var(--accent-dim),transparent);}

.sub-label{
  font-size:10px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;
  margin:20px 0 10px;padding-left:10px;color:var(--text-dim);
  border-left:2px solid var(--border2);
}
.sub-label.sub-action{border-color:#3b82f6;color:#3b6fa0;}
.sub-label.sub-romance{border-color:#ec4899;color:#8b3060;}
.sub-label.sub-both{border-color:#8b5cf6;color:#5a3a90;}
.sub-label.sub-other{border-color:var(--border2);color:var(--text-dim);}

/* GRID */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(148px,1fr));gap:12px;}

/* CARD */
.card{
  background:var(--surface);border:1px solid var(--border);
  border-radius:12px;overflow:hidden;
  transition:border-color .25s,transform .2s,box-shadow .25s;
  cursor:pointer;position:relative;
}
.card:hover{
  border-color:var(--accent);transform:translateY(-4px);
  box-shadow:0 8px 32px rgba(0,0,0,0.6),0 0 20px var(--accent-glow);
}
/* image wrapper for gradient overlay */
.card-img-wrap{position:relative;width:100%;}
.card img{width:100%;aspect-ratio:2/3;object-fit:cover;display:block;background:var(--surface2);}
/* gradient over bottom of image */
.card-img-wrap::after{
  content:'';position:absolute;bottom:0;left:0;right:0;height:40%;
  background:linear-gradient(to bottom,transparent,rgba(15,15,26,0.7));
  pointer-events:none;
}
.card-placeholder{
  width:100%;aspect-ratio:2/3;background:var(--surface2);
  display:flex;align-items:center;justify-content:center;
  font-size:10px;color:var(--text-dim);text-align:center;padding:8px;
}
.card-body{padding:9px 10px 11px;}
.card-title{font-size:11px;font-weight:600;color:var(--text);line-height:1.35;margin-bottom:5px;}
.card-rating{display:flex;align-items:center;gap:4px;margin-bottom:6px;}
.stars{color:var(--gold);font-size:10px;letter-spacing:1.5px;}
.rating-num{font-size:10px;color:var(--text-muted);font-weight:300;}
.card-tags{display:flex;flex-wrap:wrap;gap:3px;}

/* TAGS */
.tag{font-size:9px;padding:2px 7px;border-radius:999px;font-weight:500;letter-spacing:.02em;}
.tag-rank{background:rgba(245,158,11,0.12);color:var(--gold);border:1px solid rgba(245,158,11,0.25);}
.tag-romance{background:rgba(236,72,153,0.1);color:#f472b6;border:1px solid rgba(236,72,153,0.2);}
.tag-action{background:rgba(59,130,246,0.1);color:#60a5fa;border:1px solid rgba(59,130,246,0.2);}
.tag-isekai{background:rgba(52,211,153,0.1);color:#34d399;border:1px solid rgba(52,211,153,0.2);}
.tag-comedy{background:rgba(139,92,246,0.1);color:#a78bfa;border:1px solid rgba(139,92,246,0.2);}
.tag-peak{background:rgba(16,185,129,0.1);color:#10b981;border:1px solid rgba(16,185,129,0.2);}
.tag-fuller{background:rgba(251,146,60,0.1);color:#fb923c;border:1px solid rgba(251,146,60,0.2);}
.tag-clips{background:rgba(100,116,139,0.1);color:#94a3b8;border:1px solid rgba(100,116,139,0.2);}
.tag-unfinished{background:rgba(248,113,113,0.1);color:#f87171;border:1px solid rgba(248,113,113,0.2);}

/* SHOW MORE */
.card.hidden-card{display:none;}
.card.hidden-card.revealed{display:block;animation:fadeIn .3s ease;}
.show-more-btn{
  grid-column:1/-1;padding:10px;
  background:var(--surface);border:1px solid var(--border2);border-radius:10px;
  color:var(--text-muted);font-size:12px;font-weight:500;cursor:pointer;
  text-align:center;transition:all .2s;margin-top:2px;font-family:inherit;
}
.show-more-btn:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-glow);}

/* WANT LIST */
/* WATCH QUEUE */
.queue-list{display:flex;flex-direction:column;gap:8px;}
.queue-item{background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden;}
.queue-header{
  display:flex;align-items:center;gap:10px;
  padding:12px 14px;cursor:pointer;
  transition:background .15s;user-select:none;
}
.queue-header:hover{background:var(--surface2);}
.queue-priority{
  width:10px;height:10px;border-radius:50%;flex-shrink:0;
}
.queue-priority.sure{background:#34d399;box-shadow:0 0 6px rgba(52,211,153,0.5);}
.queue-priority.fence{background:#f59e0b;box-shadow:0 0 6px rgba(245,158,11,0.5);}
.queue-priority.future{background:#6b7280;box-shadow:0 0 6px rgba(107,114,128,0.3);}
.queue-title{flex:1;font-size:13px;font-weight:600;color:var(--text);}
.queue-badge{
  font-size:9px;font-weight:500;letter-spacing:.04em;padding:2px 8px;
  border-radius:999px;flex-shrink:0;
}
.queue-badge.sure{background:rgba(52,211,153,0.1);color:#34d399;border:1px solid rgba(52,211,153,0.2);}
.queue-badge.fence{background:rgba(245,158,11,0.1);color:#f59e0b;border:1px solid rgba(245,158,11,0.2);}
.queue-badge.future{background:rgba(107,114,128,0.1);color:#9ca3af;border:1px solid rgba(107,114,128,0.2);}
.queue-chevron{
  font-size:10px;color:var(--text-muted);transition:transform .2s;flex-shrink:0;
}
.queue-item.open .queue-chevron{transform:rotate(180deg);}
.queue-body{
  display:none;padding:0 14px 13px 34px;
  font-size:12px;color:#7070a0;line-height:1.7;font-weight:300;
  border-top:1px solid var(--border);padding-top:10px;
}
.queue-item.open .queue-body{display:block;}
.queue-legend{display:flex;align-items:center;gap:16px;margin-bottom:14px;flex-wrap:wrap;}
.queue-legend-item{display:flex;align-items:center;gap:5px;font-size:10px;color:var(--text-muted);}
.queue-legend-dot{width:8px;height:8px;border-radius:50%;}
.divider{height:1px;background:var(--border);margin:36px 0 0;}
.queue-toggle-btn{
  padding:9px 24px;background:var(--surface);border:1px solid var(--border2);
  border-radius:999px;color:var(--text-muted);font-size:12px;font-weight:500;
  cursor:pointer;transition:all .2s;font-family:inherit;letter-spacing:.02em;
}
.queue-toggle-btn:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-glow);}
.queue-toggle-btn.open{border-color:var(--accent);color:var(--accent);background:var(--accent-glow);}

/* MODAL */
.modal-wrap{
  display:none;position:fixed;z-index:9999;
  width:350px;max-height:85vh;overflow-y:auto;
  pointer-events:none;
  /* custom scrollbar */
  scrollbar-width:thin;scrollbar-color:var(--border2) transparent;
}
.modal-wrap::-webkit-scrollbar{width:4px;}
.modal-wrap::-webkit-scrollbar-track{background:transparent;}
.modal-wrap::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px;}
.modal-wrap.open{display:block;pointer-events:all;}
.modal{
  background:rgba(14,14,24,0.96);
  border:1px solid var(--border2);border-radius:16px;overflow:hidden;
  box-shadow:0 20px 60px rgba(0,0,0,0.9),0 0 0 1px rgba(167,139,250,0.05);
  backdrop-filter:blur(20px);
  animation:fadeUp .2s cubic-bezier(.16,1,.3,1);
}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px) scale(.98);}to{opacity:1;transform:translateY(0) scale(1);}}
@keyframes fadeIn{from{opacity:0;}to{opacity:1;}}
.modal-top{display:flex;gap:14px;padding:16px;}
.modal-img{
  width:88px;flex-shrink:0;border-radius:8px;
  object-fit:cover;aspect-ratio:2/3;background:var(--surface2);display:block;
  box-shadow:0 4px 20px rgba(0,0,0,0.6);
}
.modal-info{flex:1;min-width:0;}
.modal-title{font-size:14px;font-weight:600;color:#f0f0ff;margin-bottom:6px;line-height:1.35;}
.modal-rating{display:flex;align-items:center;gap:6px;margin-bottom:8px;}
.modal-stars{color:var(--gold);font-size:12px;letter-spacing:1px;}
.modal-score{font-size:11px;color:var(--text-muted);font-weight:300;}
.modal-tags{display:flex;flex-wrap:wrap;gap:3px;}
.modal-divider{height:1px;background:var(--border);margin:0 16px;}
.modal-body{padding:14px 16px 16px;}
.modal-sec{
  font-size:9px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;
  margin-bottom:6px;color:var(--text-dim);
}
.modal-sec.sec-notes{margin-top:12px;}
.modal-summary-text{font-size:12px;color:#7070a0;line-height:1.7;font-weight:300;}
.modal-note-text{font-size:12px;line-height:1.7;font-style:italic;font-weight:400;}
.modal-note-none{font-size:12px;color:var(--text-dim);font-style:italic;}

/* enchantment glint on modal */
.modal{position:relative;}
.modal::before{
  content:'';
  position:absolute;inset:0;z-index:0;border-radius:16px;
  background:linear-gradient(
    115deg,
    transparent 20%,
    rgba(120,80,255,0.07) 30%,
    rgba(180,120,255,0.16) 38%,
    rgba(100,200,255,0.10) 44%,
    rgba(180,80,255,0.07) 50%,
    transparent 60%
  );
  background-size:250% 100%;
  animation:glint 3.5s linear infinite;
  pointer-events:none;
}
.modal::after{
  content:'';
  position:absolute;inset:0;z-index:0;border-radius:16px;
  background:linear-gradient(
    115deg,
    transparent 30%,
    rgba(80,160,255,0.05) 45%,
    rgba(200,100,255,0.09) 52%,
    rgba(80,220,200,0.06) 58%,
    transparent 70%
  );
  background-size:250% 100%;
  animation:glint 3.5s linear infinite 1.75s;
  pointer-events:none;
}
/* keep modal content above the glint layers */
.modal-top,.modal-divider,.modal-body,.modal-close-btn{position:relative;z-index:1;}
@keyframes glint{
  0%{background-position:200% 0;}
  100%{background-position:-50% 0;}
}
.modal-close-btn{
  display:block;width:calc(100% - 32px);margin:0 16px 16px;
  padding:9px;background:rgba(76,61,143,0.2);
  border:1px solid var(--accent-dim);border-radius:9px;
  color:var(--accent);font-size:12px;font-weight:500;cursor:pointer;
  text-align:center;transition:all .2s;font-family:inherit;
}
.modal-close-btn:hover{background:rgba(76,61,143,0.4);box-shadow:0 0 16px var(--accent-glow);}

/* RECOMMEND MODAL */
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:400;align-items:center;justify-content:center;backdrop-filter:blur(4px);}
.overlay.open{display:flex;}
.rec-modal{
  background:rgba(14,14,24,0.98);border:1px solid var(--border2);
  border-radius:18px;padding:26px;width:100%;max-width:390px;
  box-shadow:0 24px 80px rgba(0,0,0,0.95);
  animation:fadeUp .22s cubic-bezier(.16,1,.3,1);
}
.rec-modal h2{font-size:17px;font-weight:600;color:#f0f0ff;margin-bottom:4px;}
.rec-modal p{font-size:12px;color:var(--text-muted);margin-bottom:20px;font-weight:300;}
.rec-field{margin-bottom:14px;}
.rec-label-row{display:flex;align-items:center;gap:6px;margin-bottom:6px;}
.rec-label{font-size:11px;font-weight:600;color:#8080b0;letter-spacing:.04em;}
.info-icon{
  width:15px;height:15px;border-radius:50%;background:var(--surface2);
  border:1px solid var(--border2);color:var(--text-muted);font-size:9px;
  display:inline-flex;align-items:center;justify-content:center;
  cursor:help;flex-shrink:0;position:relative;
}
.info-icon:hover::after{
  content:attr(data-tip);position:absolute;left:20px;top:-4px;
  background:var(--surface2);border:1px solid var(--border2);
  border-radius:7px;padding:5px 10px;font-size:11px;color:var(--text);
  white-space:nowrap;z-index:10;pointer-events:none;
  box-shadow:0 4px 16px rgba(0,0,0,0.5);
}
.rec-input{
  width:100%;background:var(--bg);border:1px solid var(--border2);
  border-radius:9px;padding:10px 13px;color:var(--text);font-size:13px;
  outline:none;transition:border-color .2s,box-shadow .2s;font-family:inherit;font-weight:300;
}
.rec-input:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-glow);}
.rec-input::placeholder{color:var(--text-dim);}
textarea.rec-input{resize:none;height:76px;}
.rec-actions{display:flex;gap:8px;margin-top:20px;}
.rec-submit{
  flex:1;padding:11px;background:rgba(76,61,143,0.25);
  border:1px solid var(--accent-dim);border-radius:9px;
  color:var(--accent);font-size:13px;font-weight:500;cursor:pointer;
  transition:all .2s;font-family:inherit;
}
.rec-submit:hover{background:rgba(76,61,143,0.45);box-shadow:0 0 20px var(--accent-glow);}
.rec-cancel{
  padding:11px 18px;background:transparent;border:1px solid var(--border2);
  border-radius:9px;color:var(--text-muted);font-size:13px;cursor:pointer;
  transition:all .2s;font-family:inherit;
}
.rec-cancel:hover{border-color:var(--border2);color:var(--text);}
.rec-status{font-size:12px;text-align:center;margin-top:10px;min-height:18px;}
.rec-status.ok{color:#34d399;}
.rec-status.err{color:#f87171;}
</style>
</head>
<body>

<div class="hero">
  <div class="hero-bg"></div>
  <div class="hero-overlay"></div>
  <div class="hero-text">
    <div class="hero-eyebrow">Personal Rankings</div>
    <img src="data:image/png;base64," alt="MAO icon" style="width:72px;height:72px;border-radius:16px;margin-bottom:12px;display:block;box-shadow:0 4px 24px rgba(0,0,0,0.6);">
    <div class="hero-title">My Anime Opinion</div>
    <div class="hero-sub">42 shows &nbsp;·&nbsp; MAL ratings &nbsp;·&nbsp; personal notes</div>
  </div>
</div>

<div class="body">
  <div class="filters-row">
    <div class="filters" id="filters">
      <span class="pill active" data-filter="all">All</span>
      <span class="pill" data-filter="t5">Top 5</span>
      <span class="pill" data-filter="t10">Top 10</span>
      <span class="pill" data-filter="romance">Romance</span>
      <span class="pill" data-filter="action">Action</span>
      <span class="pill" data-filter="isekai">Isekai</span>
      <span class="pill" data-filter="comedy">Comedy</span>
      <span class="pill" data-filter="peak">Peak</span>
      <span class="pill" data-filter="fuller">Fuller Rec</span>
      <span class="pill" data-filter="clips">From Clips</span>
    </div>
    <button class="rec-btn" id="rec-open-btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      Recommend a show
    </button>
  </div>
  <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
    <span style="font-size:11px;color:var(--text-muted);font-style:italic;">Not sure what to recommend?</span>
    <a href="#watch-queue-anchor" onclick="openAndScrollQueue()" style="display:inline-flex;align-items:center;gap:5px;padding:5px 14px;border-radius:999px;font-size:11px;font-weight:500;border:1px solid var(--accent-dim);background:var(--accent-glow);color:var(--accent);text-decoration:none;transition:all .2s;">
      Jump to the Queue! ↓
    </a>
  </div>

  <div id="main-list"></div>
  <div id="want-section"></div>
</div>

<!-- MODAL - outside .body so fixed positioning works cleanly -->
<div class="modal-wrap" id="modal-wrap">
  <div class="modal">
