<!-- RECOMMEND OVERLAY -->
<div class="overlay" id="rec-overlay">
  <div class="rec-modal">
    <h2>Recommend a Show</h2>
    <p>Send me a recommendation and I'll check it out!</p>
    <div style="background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.2);border-radius:8px;padding:8px 12px;margin-bottom:16px;font-size:11px;color:#f59e0b;line-height:1.5;">
      ⚠️ Please check the <strong>Watch Queue</strong> at the bottom of the site before recommending — it may already be on my list!
    </div>
    <div class="rec-field">
      <div class="rec-label-row"><span class="rec-label">Show Name</span></div>
      <input class="rec-input" id="rec-name" type="text" placeholder="e.g. Frieren: Beyond Journey's End">
    </div>
    <div class="rec-field">
      <div class="rec-label-row">
        <span class="rec-label">Viewing Platform</span>
        <span class="info-icon" data-tip="Where can I watch this show?">?</span>
      </div>
      <input class="rec-input" id="rec-platform" type="text" placeholder="e.g. Crunchyroll, Netflix, Funimation">
    </div>
    <div class="rec-field">
      <div class="rec-label-row"><span class="rec-label">Other Information / Your Name</span></div>
      <textarea class="rec-input" id="rec-info" placeholder="Why should I watch it? Also drop your name so I know who to thank for the rec!"></textarea>
    </div>
    <div class="rec-actions">
      <button class="rec-cancel" id="rec-cancel">Cancel</button>
      <button class="rec-submit" id="rec-submit">Send Recommendation</button>
    </div>
    <div class="rec-status" id="rec-status"></div>
  </div>
</div>

