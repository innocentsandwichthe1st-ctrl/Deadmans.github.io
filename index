const shows = [{"title": "Attack on Titan", "tags": ["action"], "rank": "T5", "peak": false, "fuller": false, "clips": false, "meh": false, "trash": false, "mal": 9.0, "note": "My first full watch so ofc it's my number one OAT.", "summary": "Humanity lives inside cities surrounded by enormous walls due to Titans, gigantic humanoids that eat people seemingly without reason. When a Titan breaches the wall, young Eren Yeager vows to exterminate them all.", "img": "img/Attack on Titan.jpeg"}, {"title": "Death Note", "tags": ["action"], "rank": "T5", "peak": false, "fuller": false, "clips": true, "meh": false, "trash": false, "mal": 8.6, "note": "Second fav anime OAT.", "summary": "A high school student discovers a supernatural notebook that kills anyone whose name is written in it. He sets out to create a utopia free of criminals, but a genius detective closes in on him.", "img": "img/Death Note.jpeg"}, {"title": "Vinland Saga", "tags": ["action"], "rank": "T5", "peak": false, "fuller": false, "clips": false, "meh": false, "trash": false, "mal": 8.7, "note": "Top 5 anime OAT.", "summary": "Young Thorfinn grows up hearing tales of the legendary land across the ocean. After his father is killed, he joins the crew of the man responsible, seeking revenge while caught in the middle of a brutal war.", "img": "img/Vinland Saga.jpeg"}, {"title": "Cyberpunk: Edgerunners", "tags": ["action", "romance"], "rank": "T5", "peak": false, "fuller": false, "clips": true, "meh": false, "trash": false, "mal": 8.6, "note": "Don't get me started on that fuckass song. 9/10.", "summary": "Set in a dystopian Night City, a street kid tries to survive by becoming an edgerunner — a mercenary outlaw. He takes on a cybernetic implant that slowly drives people insane, all while falling for a daring netrunner.", "img": "img/Cyberpunk Edgerunners.jpeg"}, {"title": "Jujutsu Kaisen", "tags": ["action"], "rank": "T5", "peak": false, "fuller": true, "clips": false, "meh": false, "trash": false, "mal": 8.6, "note": "Peak on peak.", "summary": "After swallowing a cursed object to save his friends, Yuji Itadori becomes the host of a powerful demon. He joins a secret organization of jujutsu sorcerers to collect and destroy all cursed fingers before being executed.", "img": "img/Jujutsu Kaisen.jpeg"}, {"title": "The Quintessential Quintuplets", "tags": ["romance"], "rank": "T5", "peak": false, "fuller": false, "clips": false, "meh": false, "trash": false, "mal": 7.9, "note": "#1 best romance btw.", "summary": "A poor but academically gifted high schooler is hired to tutor five identical quintuplet sisters who are all failing. The story flashes forward to reveal he eventually marries one of them — but which one?", "img": "img/The Quintessential Quintuplets.jpeg"}, {"title": "KonoSuba: God's Blessing on This Wonderful World!", "tags": ["isekai", "comedy"], "rank": "T5", "peak": true, "fuller": true, "clips": false, "meh": false, "trash": false, "mal": 8.2, "note": "Funniest isekai ever.", "summary": "A teenager dies a laughable death and is reincarnated in a fantasy world with a useless goddess, an explosion-obsessed mage, and a masochistic crusader. They're all terrible at their jobs and it's perfect.", "img": "img/KonoSuba God's Blessing on This Wonderful World.jpeg"}, {"title": "Call of the Night", "tags": ["romance"], "rank": "T5", "peak": true, "fuller": false, "clips": true, "meh": false, "trash": false, "mal": 8.1, "note": "Really good romance, prob top 5 romances.", "summary": "A boy who can't sleep starts wandering the city at night and meets a cheerful vampire girl. To become a vampire himself, he must fall in love with her — but genuine feelings are harder to manufacture than he thinks.", "img": "img/Call of the Night.jpeg"}, {"title": "TONIKAWA: Over The Moon For You", "tags": ["romance"], "rank": "T5", "peak": false, "fuller": false, "clips": false, "meh": false, "trash": false, "mal": 8.1, "note": "Really good, prob my second fav romance.", "summary": "A genius student is saved from an accident by a beautiful girl and proposes on the spot. She agrees — on the condition they get married first before dating. Wholesome newlywed life follows.", "img": "img/TONIKAWA Over The Moon For You.jpeg"}, {"title": "Masamune-kun's Revenge", "tags": ["romance"], "rank": "T5", "peak": true, "fuller": false, "clips": false, "meh": false, "trash": false, "mal": 7.0, "note": "Good romance with lots of plot twists. Pretty moving near the end.", "summary": "A chubby kid was cruelly rejected by a rich girl and spent years getting hot to take revenge. He returns to her school to make her fall for him and break her heart — but things get complicated fast.", "img": "img/Masamune-kun's Revenge.jpeg"}, {"title": "You and I Are Polar Opposites", "tags": ["romance", "comedy"], "rank": "T5", "peak": true, "fuller": false, "clips": false, "meh": false, "trash": false, "mal": 8.1, "note": "Funniest newer romance I've seen so far. S2 comes out July 5th.", "summary": "A serious disciplinary committee member and a carefree delinquent are complete opposites — but somehow keep getting pulled into each other's orbit. Their bickering slowly turns into something neither expected.", "img": "img/You and I Are Polar Opposites.jpeg"}, {"title": "Rascal Does Not Dream of Bunny Girl Senpai", "tags": ["romance", "comedy"], "rank": "T10", "peak": false, "fuller": false, "clips": true, "meh": false, "trash": false, "mal": 8.3, "note": "Very good and prob the funniest romcom anime.", "summary": "A high schooler encounters girls suffering from 'Puberty Syndrome' — a phenomenon causing bizarre supernatural experiences tied to adolescent emotions. He helps each one while developing feelings for a sharp-tongued girl.", "img": "img/Rascal Does Not Dream of Bunny Girl Senpai.jpeg"}, {"title": "Chainsaw Man", "tags": ["action", "romance"], "rank": "T10", "peak": false, "fuller": false, "clips": false, "meh": false, "trash": false, "mal": 8.7, "note": "Very good show and movie.", "summary": "Denji, a broke devil hunter, merges with his chainsaw devil dog and gains the ability to sprout chainsaws from his body. He joins a government agency hunting devils and just wants to live a normal life.", "img": "img/Chainsaw Man.jpeg"}, {"title": "The Case Study of Vanitas", "tags": ["action", "romance", "comedy"], "rank": "T10", "peak": true, "fuller": true, "clips": false, "meh": false, "trash": false, "mal": 7.8, "note": "Came for the vampires, stayed for the romance.", "summary": "In a steampunk Paris, a vampire named Noé encounters a quirky human doctor carrying the Book of Vanitas, which he claims can cure cursed vampires. Their odd partnership leads to intrigue, action, and unexpected romance.", "img": "img/The Case Study of Vanitas.jpeg"}, {"title": "Zombieland Saga", "tags": ["comedy"], "rank": "T10", "peak": true, "fuller": false, "clips": true, "meh": false, "trash": false, "mal": 7.9, "note": "First musical comedy I watched. Very good.", "summary": "A zombie idol group made up of legendary girls from different eras of Japanese history is formed by a shady manager to save Saga prefecture. Equal parts absurd comedy and surprisingly heartfelt idol drama.", "img": "img/Zombieland Saga.jpeg"}, {"title": "DAN DA DAN", "tags": ["romance", "action"], "rank": "T10", "peak": true, "fuller": true, "clips": false, "meh": false, "trash": false, "mal": 8.6, "note": "Good romance / shonen-ish anime.", "summary": "A girl who believes in ghosts and a boy who believes in aliens make a bet — and both end up getting haunted. Now they're fighting supernatural enemies together while awkwardly developing feelings for each other.", "img": "img/DAN DA DAN.jpeg"}, {"title": "Zom 100: Bucket List of the Dead", "tags": ["action", "comedy"], "rank": "T10", "peak": true, "fuller": false, "clips": true, "meh": false, "trash": false, "mal": 7.9, "note": "Really good zombie show, def recommend for its comedy.", "summary": "A burned-out office worker wakes up to a zombie apocalypse and realizes he's finally free from his awful job. He decides to make a bucket list of 100 things to do before he becomes a zombie himself.", "img": "img/Zom 100 Bucket List of the Dead.jpeg"}, {"title": "More than a Married Couple, but Not Lovers.", "tags": ["romance"], "rank": "T10", "peak": true, "fuller": false, "clips": false, "meh": false, "trash": false, "mal": 7.5, "note": "Good but way over hyped. I don't really get the Shiori hate.", "summary": "A school program pairs students as fake married couples to practice for adult life. A guy gets paired with the most popular girl instead of his crush — and the more they live together, the more feelings shift.", "img": "img/More than a Married Couple but Not Lovers..jpeg"}, {"title": "Hokkaido Gals Are Super Adorable!", "tags": ["romance"], "rank": "T10", "peak": true, "fuller": false, "clips": true, "meh": false, "trash": false, "mal": 7.5, "note": "Good romance, watched on a whim since I saw one clip on TikTok.", "summary": "A Tokyo boy transfers to snowy Hokkaido and is immediately charmed by the cheerful, fashionable local girls. A sweet slow-burn romance develops between him and the most outgoing girl in class.", "img": "img/Hokkaido Gals Are Super Adorable!.jpeg"}, {"title": "My Dress-Up Darling", "tags": ["romance"], "rank": "T10", "peak": true, "fuller": false, "clips": false, "meh": false, "trash": false, "mal": 8.3, "note": "Blah blah cosplay, blah blah super senior, blah blah all that for a picture!? 9/10 romance.", "summary": "A shy boy who makes traditional dolls gets roped into making costumes for the most popular girl in school, who's secretly a hardcore gamer and cosplayer. They grow incredibly close through their shared passion.", "img": "img/My Dress-Up Darling.jpeg"}, {"title": "Inuyashiki: Last Hero", "tags": ["action"], "rank": "T10", "peak": true, "fuller": false, "clips": true, "meh": false, "trash": false, "mal": 8.0, "note": "Larp show, but good shonen.", "summary": "A middle-aged loser and a teenage boy are both struck by an alien spacecraft and rebuilt as powerful androids. One uses his new body to save lives; the other uses his to take them. Their collision is inevitable.", "img": "img/Inuyashiki Last Hero.jpeg"}, {"title": "Platinum End", "tags": ["romance", "action"], "rank": "T10", "peak": true, "fuller": false, "clips": false, "meh": false, "trash": false, "mal": 6.8, "note": "Good show, would recommend.", "summary": "After attempting suicide, a boy is saved by his guardian angel and granted special powers. He's thrust into a battle royale where 13 god candidates compete to become the next God within 999 days.", "img": "img/Platinum End.jpeg"}, {"title": "The Angel Next Door Spoils Me Rotten", "tags": ["romance"], "rank": "T10", "peak": true, "fuller": true, "clips": false, "meh": false, "trash": false, "mal": 8.0, "note": "Peak. New season just dropped too.", "summary": "The most beautiful and perfect girl at school lives next door to a lonely guy. After he lends her his umbrella, she starts cooking for him and taking care of him — and neither can explain why.", "img": "img/The Angel Next Door Spoils Me Rotten.jpeg"}, {"title": "Our Dating Story: The Experienced You and The Inexperienced Me", "tags": ["romance"], "rank": "T10", "peak": true, "fuller": false, "clips": false, "meh": false, "trash": false, "mal": 7.8, "note": "Very good romance since they get together on the first or second ep.", "summary": "A gal and an average guy end up dating after a misunderstanding. Instead of a will-they-won't-they, it skips straight to the relationship — focusing on how two very different people actually make it work.", "img": "img/Our Dating Story The Experienced You and The Inexperienced Me.jpeg"}, {"title": "Terror in Resonance", "tags": ["action"], "rank": "T10", "peak": true, "fuller": false, "clips": true, "meh": false, "trash": false, "mal": 8.1, "note": "Bro this show is so good. Nice change of pace from romances. Really cool premise.", "summary": "Two mysterious teenagers calling themselves Sphinx carry out a series of bombings across Tokyo, uploading riddles online and daring the police to stop them. A brilliant detective races to unravel who they really are.", "img": "img/Terror in Resonance.jpeg"}, {"title": "Watari-kun's ****** is About to Collapse", "tags": ["romance"], "rank": "T10", "peak": false, "fuller": false, "clips": true, "meh": false, "trash": false, "mal": 7.4, "note": "Nice romance, interesting relationship dynamic. MC is very very stupid though.", "summary": "A popular playboy who juggles multiple girls at once finds his carefully managed love life falling apart when his childhood friend gets involved. A surprisingly self-aware romcom about a guy too dumb for his own schemes.", "img": "img/Watari-kuns is About to Collapse.jpeg"}, {"title": "Lookism", "tags": ["action"], "rank": null, "peak": true, "fuller": false, "clips": true, "meh": false, "trash": false, "mal": 7.9, "note": "Good show for larpers and non-larpers alike.", "summary": "A bullied overweight teen wakes up able to switch between his original body and a new handsome one. He navigates high school and underground street fights, exploring how differently the world treats people based on looks.", "img": "img/Lookism.jpeg"}, {"title": "Obsolete", "tags": ["action"], "rank": null, "peak": true, "fuller": false, "clips": false, "meh": false, "trash": false, "mal": 7.2, "note": "Not really an anime I'd say but it's really cool.", "summary": "Alien merchants arrive on Earth offering to trade mech suits for limestone. Nations and private groups acquire the mechs, and the world's military balance shifts completely. A grounded, realistic take on mech warfare.", "img": "img/Obsolete.jpeg"}, {"title": "Don't Toy with Me, Miss Nagatoro", "tags": ["romance"], "rank": null, "peak": true, "fuller": false, "clips": true, "meh": false, "trash": false, "mal": 7.6, "note": "Very nice, wish it was longer.", "summary": "A shy loner who loves drawing gets found out by a younger underclassman who starts teasing him relentlessly. What starts as bullying slowly reveals itself as her clumsy way of getting close to the only person she finds interesting.", "img": "img/Don't Toy with Me Miss Nagatoro.jpeg"}, {"title": "Assassination Classroom", "tags": ["action"], "rank": null, "peak": false, "fuller": false, "clips": true, "meh": false, "trash": false, "unfinished": true, "mal": 8.1, "note": "Too much inner dialogue but still good.", "summary": "A powerful creature destroys most of the moon and threatens to do the same to Earth — unless a class of misfit students can assassinate him by graduation. The catch: he's their homeroom teacher and genuinely cares about them.", "img": "img/Assassination Classroom.jpeg"}, {"title": "Handyman Saitou in Another World", "tags": ["isekai", "comedy"], "rank": null, "peak": false, "fuller": false, "clips": true, "meh": false, "trash": false, "mal": 7.8, "note": "Pretty good isekai, prob the second funniest isekai.", "summary": "An ordinary handyman is transported to a fantasy world where his repair skills turn out to be just as valuable as magic or swordsmanship. A wholesome, funny isekai that celebrates practical everyday people.", "img": "img/Handyman Saitou in Another World.jpeg"}, {"title": "Hellsing Ultimate", "tags": ["action"], "rank": null, "peak": false, "fuller": false, "clips": true, "meh": false, "trash": false, "mal": 8.5, "note": "Saw the edits of Alucard aura farming and knew I had to watch it. Pretty good vampire show.", "summary": "The Hellsing Organization defends England from vampires and ghouls using their most powerful weapon: Alucard, the world's most terrifying vampire, who fights on humanity's side.", "img": "img/Hellsing Ultimate.jpeg"}, {"title": "A Couple of Cuckoos", "tags": ["romance"], "rank": null, "peak": true, "fuller": false, "clips": false, "meh": false, "trash": false, "mal": 7.1, "note": "Holy shit, why do so many girls love him bro. Pass the ball!", "summary": "Two teens discover they were accidentally switched at birth and their families suggest they get engaged. The problem: he already likes someone else, she's trying to escape an arranged marriage, and feelings keep getting messier.", "img": "img/A Couple of Cuckoos.jpeg"}, {"title": "I Made a Friend Who is a Gyaru and She is Cute", "tags": ["romance"], "rank": null, "peak": true, "fuller": false, "clips": false, "meh": false, "trash": false, "mal": 7.6, "note": "So far it's good, still coming out.", "summary": "A loner who gave up on socializing is approached by the second most popular girl in school, who just wants a real friend with no ulterior motives. An honest, low-drama friendship-to-romance story.", "img": "img/I made friends with the second prettiest girl in my class.jpeg"}, {"title": "Gal & Otaku Can't Understand Each Other", "tags": ["romance"], "rank": null, "peak": true, "fuller": false, "clips": false, "meh": false, "trash": false, "mal": 7.7, "note": "Really new, really good so far.", "summary": "The most popular gal in school befriends a nerdy otaku and starts getting drawn into his hobby world. A surprisingly sweet romance about two people from completely different social worlds finding common ground.", "img": "img/Gals can't be kind to Otaku.jpeg"}, {"title": "Tomo-chan Is a Girl!", "tags": ["romance", "comedy"], "rank": null, "peak": false, "fuller": false, "clips": false, "meh": true, "trash": false, "mal": 7.7, "note": "Its a Tomboy romance and it was alright. There wasn't much to it to be honest, it was basically just a normal romance plot. Some of the reactions were pretty funny though.", "summary": "A tough, tomboyish girl has been in love with her childhood best friend forever — but he only sees her as a guy. She's determined to make him see her as a woman while absolutely refusing to change who she is.", "img": "img/Tomo-chan Is a Girl!.jpeg"}, {"title": "Horimiya", "tags": ["romance"], "rank": null, "peak": false, "fuller": false, "clips": false, "meh": false, "trash": false, "mal": 8.2, "note": "Pretty good romance. They actually crack btw.", "summary": "A popular girl and a quiet mysterious boy discover each other's hidden sides outside of school. They quickly become close and, unlike most romance anime, actually get together early — then deal with what comes next.", "img": "img/Horimiya.jpeg"}, {"title": "MF Ghost", "tags": ["action", "romance"], "rank": null, "peak": false, "fuller": false, "clips": false, "meh": true, "trash": false, "unfinished": true, "mal": 7.3, "note": "Car show I have a hard time watching cuz it's just all racing, nothing else besides a small romance.", "summary": "Set in a near-future where self-driving cars are the norm, a young driver returns to Japan to compete in an illegal mountain pass race. A spiritual successor to Initial D, heavy on racing and light on everything else.", "img": "img/MF Ghost.jpeg"}, {"title": "And You Thought There Is Never a Girl Online?", "tags": ["isekai", "comedy", "romance"], "rank": null, "peak": false, "fuller": false, "clips": false, "meh": true, "trash": false, "mal": 7.0, "note": "It's like an off brand Konosuba but with more fan service.", "summary": "A guy who got burned by a girl online swears never to trust female players again — then discovers his in-game wife is actually a girl in real life. Their entire gaming guild turns out to be classmates.", "img": "img/And You Thought There Is Never a Girl Online.jpeg"}, {"title": "I Got a Cheat Skill in Another World and Became Unrivaled in the Real World, Too", "tags": ["isekai", "romance"], "rank": null, "peak": false, "fuller": false, "clips": false, "meh": true, "trash": false, "mal": 6.5, "note": "I liked the story but the season ended abruptly. S2 is apparently on the way.", "summary": "A bullied boy finds a door to another world and gains godlike skills. He becomes overpowered in the fantasy world and, thanks to a physical transformation, suddenly popular back in the real one too.", "img": "img/I Got a Cheat Skill in Another World and Became Unrivaled in the Real World Too.jpeg"}, {"title": "Medaka Kuroiwa Is Impervious to My Charms", "tags": ["romance"], "rank": null, "peak": false, "fuller": false, "clips": false, "meh": true, "trash": false, "mal": 7.2, "note": "Lowkey kinda mid.", "summary": "The most popular girl in school has never failed to get a guy's attention — until she meets a classmate raised by monks who is completely immune to feminine charms. His indifference drives her crazy and somehow makes her fall first.", "img": "img/Medaka Kuroiwa Is Impervious to My Charms.jpeg"}, {"title": "Komi Can't Communicate", "tags": ["romance"], "rank": null, "peak": false, "fuller": false, "clips": false, "meh": false, "trash": true, "unfinished": true, "mal": 7.3, "note": "Fuck this show, may come back to it.", "summary": "The most beautiful girl in school has extreme social anxiety and can't speak to anyone. A kind boy sits next to her and helps her on her goal of making 100 friends. Sweet premise, slow execution.", "img": "img/Komi Can't Communicate.jpeg"}, {"title": "I Want to End This Love Game", "tags": ["romance"], "rank": null, "peak": true, "fuller": false, "clips": false, "meh": false, "trash": false, "mal": 7.5, "note": "This shows central plot is interesting and it actually works really well and its very intriguing.", "summary": "A girl who has never experienced genuine love and a boy who uses romance as a game cross paths. What starts as manipulation slowly turns into something neither of them planned for.", "img": "img/I Want to End This Love Game.jpeg"}, {"title": "Haibara's Teenage New Game+", "tags": ["romance"], "rank": null, "peak": true, "fuller": false, "clips": false, "meh": false, "trash": false, "mal": 7.8, "note": "I thought it was kind of similar to \"I got a cheat skill\" with the way the mc transforms and lives a completely different life. Overall different in most other ways. Good show.", "summary": "A boy gets a chance to redo his teenage years with all his memories intact. This time around, armed with experience and a completely different appearance, he sets out to change the things he regretted most — including the girl he never got close to.", "img": "img/Haibara's Teenage New Game+.jpeg"}, {"title": "Darwin's Game", "tags": ["action"], "rank": "T10", "peak": true, "fuller": false, "clips": false, "meh": false, "trash": false, "mal": 7.9, "note": "Really enjoyable action anime that has a nice fight dynamic. Mc's Power is pretty cool. Small amount of romance but its really one-sided as the guy could really care less about the feelings of the girl. Overall a really good show to watch and i wish it would get a season 2.", "summary": "A high schooler gets invited to a mysterious mobile game called Darwin's Game, only to discover players fight to the death using special abilities called Sigils. He must survive and uncover the truth behind the game.", "img": "img/Darwin's Game.jpeg"}, {"title": "Can a Boy-Girl Friendship Survive?", "tags": ["romance"], "rank": null, "peak": false, "fuller": false, "clips": true, "meh": true, "trash": false, "mal": 7.1, "note": "Eh, pretty forgettable romance. Not a whole lot to it, but id say it was a ok watch.", "summary": "Two classmates agree to just be friends despite obvious mutual attraction. The series follows their attempts to maintain that boundary while everyone around them — and their own feelings — keep pushing against it.", "img": "img/Can a Boy-Girl Friendship Survive.jpeg"}];

function stars(n){const r=Math.round(n/2);return"★".repeat(r)+"☆".repeat(5-r);}

function noteColor(rank,tags){
  return "#f0a030";
}

function buildTags(s){
  let t="";
  if(s.rank==="T5") t+=`<span class="tag tag-rank">Top 5</span>`;
  else if(s.rank==="T10") t+=`<span class="tag tag-rank">Top 10</span>`;
  if(s.tags.includes("romance")) t+=`<span class="tag tag-romance">Romance</span>`;
  if(s.tags.includes("action")) t+=`<span class="tag tag-action">Action</span>`;
  if(s.tags.includes("isekai")) t+=`<span class="tag tag-isekai">Isekai</span>`;
  if(s.tags.includes("comedy")) t+=`<span class="tag tag-comedy">Comedy</span>`;
  if(s.peak) t+=`<span class="tag tag-peak">Peak</span>`;
  if(s.fuller) t+=`<span class="tag tag-fuller">Fuller Rec</span>`;
  if(s.clips) t+=`<span class="tag tag-clips">From Clips</span>`;
  if(s.unfinished) t+=`<span class="tag tag-unfinished">Unfinished</span>`;
  return t;
}

function card(s,idx,total){
  const hidden = idx >= 3 && total > 3;
  const imgEl = `<div class="card-img-wrap"><img src="${s.img}" alt="${s.title}" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
<div class="card-placeholder" style="display:none">${s.title}</div></div>`;
  return `<div class="card${hidden?" hidden-card":""}" data-title="${s.title.replace(/"/g,'&quot;')}">
${imgEl}
<div class="card-body">
<div class="card-title">${s.title}</div>
<div class="card-rating"><span class="stars">${stars(s.mal)}</span><span class="rating-num">${s.mal.toFixed(1)}</span></div>
<div class="card-tags">${buildTags(s)}</div>
</div></div>`;
}

function grid(items){
  if(!items.length) return "";
  const cards = items.map((s,i)=>card(s,i,items.length)).join("");
  const hasMore = items.length > 3;
  const btn = hasMore ? `<div class="show-more-btn" data-showing="false">Show ${items.length-3} more ▾</div>` : "";
  return `<div class="grid">${cards}${btn}</div>`;
}

function sectionLabel(text,cls){
  return `<div class="section-label ${cls}">${text}</div>`;
}

function rankedBlock(rank,rankLabel,rankCls,items){
  const ranked=items.filter(s=>s.rank===rank);
  if(!ranked.length) return "";
  const ao=ranked.filter(s=>s.tags.includes("action")&&!s.tags.includes("romance"));
  const ro=ranked.filter(s=>s.tags.includes("romance")&&!s.tags.includes("action"));
  const bo=ranked.filter(s=>s.tags.includes("action")&&s.tags.includes("romance"));
  const ot=ranked.filter(s=>!s.tags.includes("action")&&!s.tags.includes("romance"));
  let h=sectionLabel(rankLabel,rankCls);
  if(ao.length) h+=`<div class="sub-label sub-action">Action</div>${grid(ao)}`;
  if(ro.length) h+=`<div class="sub-label sub-romance">Romance</div>${grid(ro)}`;
  if(bo.length) h+=`<div class="sub-label sub-both">Action & Romance</div>${grid(bo)}`;
  if(ot.length) h+=`<div class="sub-label sub-other">Other</div>${grid(ot)}`;
  return h;
}

function simpleBlock(label,cls,items){
  if(!items.length) return "";
  return sectionLabel(label,cls)+grid(items);
}

function render(filter){
  let f=shows;
  if(filter==="t5") f=shows.filter(s=>s.rank==="T5");
  else if(filter==="t10") f=shows.filter(s=>s.rank==="T5"||s.rank==="T10");
  else if(filter==="romance") f=shows.filter(s=>s.tags.includes("romance"));
  else if(filter==="action") f=shows.filter(s=>s.tags.includes("action"));
  else if(filter==="isekai") f=shows.filter(s=>s.tags.includes("isekai"));
  else if(filter==="comedy") f=shows.filter(s=>s.tags.includes("comedy"));
  else if(filter==="peak") f=shows.filter(s=>s.peak);
  else if(filter==="fuller") f=shows.filter(s=>s.fuller);
  else if(filter==="clips") f=shows.filter(s=>s.clips);

  const good=f.filter(s=>!s.rank&&!s.meh&&!s.trash);
  const meh=f.filter(s=>s.meh);
  const trash=f.filter(s=>s.trash);

  let html="";
  if(f.some(s=>s.rank==="T5")) html+=rankedBlock("T5","Top 5","lbl-t5",f);
  if(f.some(s=>s.rank==="T10")) html+=rankedBlock("T10","Top 10","lbl-t10",f);
  if(good.length) html+=simpleBlock("Good Watches","lbl-good",good);
  if(meh.length) html+=simpleBlock("Meh","lbl-meh",meh);
  if(trash.length) html+=simpleBlock("Trash","lbl-trash",trash);
  document.getElementById("main-list").innerHTML=html;

  const queue = [
    {title:"86: Eighty-Six", priority:"sure", why:"Heard it has one of the best stories in recent anime. Mecha with serious themes about discrimination and war — apparently hits hard emotionally."},
    {title:"Arifureta: From Commonplace to World's Strongest", priority:"sure", why:"Isekai where the MC goes from weakest to most overpowered after being betrayed. Dark tone compared to most isekai."},
    {title:"Erased", priority:"sure", why:"Time travel mystery where the MC goes back in time to prevent a murder. Supposed to be a really gripping watch."},
    {title:"From Me to You", priority:"fence", why:"A classic slow-burn romance on Netflix. Heard it's very emotional but also pretty slow paced."},
    {title:"Parasyte: The Maxim", priority:"sure", why:"Aliens take over human bodies and the MC ends up with one in his hand. Looks like a really unique action/horror concept."},
    {title:"Hell's Paradise", priority:"sure", why:"Deadly criminals sent to a mysterious island that might be paradise or hell. High action, dark tone, great animation."},
    {title:"Fullmetal Alchemist: Brotherhood", priority:"fence", why:"Widely considered the greatest anime ever made. Two brothers use alchemy and pay a terrible price. Might be a long watch but supposedly worth every episode."},
    {title:"Mob Psycho 100", priority:"fence", why:"From the creator of One Punch Man. A kid with insane psychic powers just wants to be normal. Heard the animation is insane."},
    {title:"A Silent Voice", priority:"future", why:"A movie about a boy who bullied a deaf girl trying to make amends. Supposed to be emotional but sounds heavy."},
    {title:"Re:ZERO", priority:"future", why:"Isekai where the MC dies and respawns. Apparently very dark and psychological compared to most isekai."},
  ];

  const priorityLabel = {sure:"Sure I'll Try It", fence:"On the Fence", future:"Maybe in the Future"};

  const ws = document.getElementById("want-section");
  if(filter==="all"){
    const items = queue.map((s,i)=>`
      <div class="queue-item" id="qi-${i}">
        <div class="queue-header" onclick="toggleQueue(${i})">
          <div class="queue-priority ${s.priority}"></div>
          <div class="queue-title">${s.title}</div>
          <div class="queue-badge ${s.priority}">${priorityLabel[s.priority]}</div>
          <div class="queue-chevron">▼</div>
        </div>
        <div class="queue-body">${s.why}</div>
      </div>`).join("");

    ws.innerHTML = `
<div class="divider"></div>
<div style="display:flex;justify-content:center;margin:24px 0 0;" id="watch-queue-anchor">
  <button class="queue-toggle-btn" id="queue-toggle-btn" onclick="toggleWatchQueue()">
    Watch Queue &nbsp;▾
  </button>
</div>
<div id="watch-queue-section" style="display:none;margin-top:20px;">
  ${sectionLabel("Watch Queue","lbl-want")}
  <div class="queue-legend">
    <div class="queue-legend-item"><div class="queue-legend-dot" style="background:#34d399"></div>Sure I'll Try It</div>
    <div class="queue-legend-item"><div class="queue-legend-dot" style="background:#f59e0b"></div>On the Fence</div>
    <div class="queue-legend-item"><div class="queue-legend-dot" style="background:#6b7280"></div>Maybe in the Future</div>
  </div>
  <div class="queue-list">${items}</div>
</div>`;
  } else {
    ws.innerHTML = "";
  }

  closeModal();
  bindShowMore();
}

function bindShowMore(){
  document.querySelectorAll(".show-more-btn").forEach(btn=>{
    btn.addEventListener("click",function(){
      const grid=this.parentElement;
      const hidden=grid.querySelectorAll(".hidden-card");
      const showing=this.dataset.showing==="true";
      if(!showing){
        hidden.forEach(c=>{c.classList.add("revealed");});
        this.dataset.showing="true";
        this.textContent="Hide ▴";
      } else {
        hidden.forEach(c=>{c.classList.remove("revealed");});
        this.dataset.showing="false";
        this.textContent=`Show ${hidden.length} more ▾`;
      }
    });
  });
}

// ── MODAL ──────────────────────────────────────────────
const modalWrap=document.getElementById("modal-wrap");

function closeModal(){
  modalWrap.classList.remove("open");
}

function positionModal(cardEl){
  const rect = cardEl.getBoundingClientRect();
  const mw = 340;
  const margin = 10;
  const vh = window.innerHeight;
  
  // Prefer right side, fallback to left
  let left = rect.right + margin;
  if(left + mw > window.innerWidth - margin){
    left = rect.left - mw - margin;
  }
  if(left < margin) left = margin;
  
  // Try to align top with card top, but keep in viewport
  let top = rect.top;
  // After modal renders we'll check height, for now estimate max
  const estimatedHeight = Math.min(500, vh - 20);
  if(top + estimatedHeight > vh - margin){
    top = Math.max(margin, vh - estimatedHeight - margin);
  }
  if(top < margin) top = margin;
  
  modalWrap.style.left = left + "px";
  modalWrap.style.top = top + "px";
}

document.addEventListener("click", e=>{
  // Ignore show-more button clicks
  if(e.target.closest(".show-more-btn")) return;
  
  const c = e.target.closest(".card");
  if(!c){
    // Click outside any card or modal — close modal
    if(!e.target.closest(".modal-wrap")) closeModal();
    return;
  }
  
  const title = c.dataset.title;
  const s = shows.find(x=>x.title===title);
  if(!s) return;
  
  // Populate modal
  document.getElementById("modal-img").src = s.img;
  document.getElementById("modal-img").alt = s.title;
  document.getElementById("modal-title").textContent = s.title;
  document.getElementById("modal-stars").textContent = stars(s.mal);
  document.getElementById("modal-score").textContent = `MAL: ${s.mal.toFixed(1)} / 10`;
  document.getElementById("modal-tags").innerHTML = buildTags(s);
  document.getElementById("modal-summary").textContent = s.summary;

  const noteLabel = document.getElementById("modal-note-label");
  const color = noteColor(s.rank, s.tags);
  noteLabel.style.color = color;
  noteLabel.style.borderLeft = `2px solid ${color}`;
  noteLabel.style.paddingLeft = "8px";

  const noteEl = document.getElementById("modal-note");
  if(s.note){
    noteEl.innerHTML = `<div class="modal-note-text" style="color:${color}">${s.note}</div>`;
  } else {
    noteEl.innerHTML = `<div class="modal-note-none">No notes added yet.</div>`;
  }

  // If clicking same card while modal open, close it
  if(modalWrap.classList.contains("open") && modalWrap._activeCard === c){
    closeModal();
    return;
  }
  
  modalWrap._activeCard = c;
  
  // Position and show
  positionModal(c);
  modalWrap.classList.add("open");
});

document.getElementById("modal-close").addEventListener("click", closeModal);

// Reposition on scroll/resize
window.addEventListener("scroll", ()=>{
  if(modalWrap.classList.contains("open") && modalWrap._activeCard){
    positionModal(modalWrap._activeCard);
  }
}, {passive:true});

// ── FILTERS ──────────────────────────────────────────────
document.getElementById("filters").addEventListener("click",e=>{
  if(!e.target.dataset.filter) return;
  document.querySelectorAll(".pill").forEach(p=>p.classList.remove("active"));
  e.target.classList.add("active");
  render(e.target.dataset.filter);
});

// ── RECOMMEND ────────────────────────────────────────────
const overlay=document.getElementById("rec-overlay");
document.getElementById("rec-open-btn").addEventListener("click",()=>overlay.classList.add("open"));
document.getElementById("rec-cancel").addEventListener("click",()=>{overlay.classList.remove("open");document.getElementById("rec-status").textContent="";});
overlay.addEventListener("click",e=>{if(e.target===overlay){overlay.classList.remove("open");document.getElementById("rec-status").textContent="";}});

document.getElementById("rec-submit").addEventListener("click",async()=>{
  const name=document.getElementById("rec-name").value.trim();
  const platform=document.getElementById("rec-platform").value.trim();
  const info=document.getElementById("rec-info").value.trim();
  const status=document.getElementById("rec-status");
  if(!name){status.className="rec-status err";status.textContent="Please enter a show name.";return;}
  const btn=document.getElementById("rec-submit");
  btn.textContent="Sending...";btn.disabled=true;
  try{
    await emailjs.send("service_h5lm8mt","template_s18adkp",{
      show_name:name,
      platform:platform||"Not specified",
      other_info:info||"None",
      to_email:"innocentsandwichthe1st@gmail.com"
    });
    status.className="rec-status ok";
    status.textContent="✓ Recommendation sent! Thanks!";
    document.getElementById("rec-name").value="";
    document.getElementById("rec-platform").value="";
    document.getElementById("rec-info").value="";
    setTimeout(()=>{overlay.classList.remove("open");status.textContent="";},2000);
  }catch(err){
    status.className="rec-status err";
    status.textContent="Failed to send. Please try again.";
  }
  btn.textContent="Send Recommendation";btn.disabled=false;
});

function openAndScrollQueue(){
  const section = document.getElementById("watch-queue-section");
  const btn = document.getElementById("queue-toggle-btn");
  if(section && section.style.display === "none"){
    section.style.display = "block";
    btn.classList.add("open");
    btn.innerHTML = "Watch Queue &nbsp;▴";
  }
  setTimeout(()=>{
    document.getElementById("watch-queue-anchor").scrollIntoView({behavior:"smooth"});
  }, 50);
}

function toggleWatchQueue(){
  const section = document.getElementById("watch-queue-section");
  const btn = document.getElementById("queue-toggle-btn");
  const isOpen = section.style.display !== "none";
  section.style.display = isOpen ? "none" : "block";
  btn.classList.toggle("open", !isOpen);
  btn.innerHTML = isOpen ? "Watch Queue &nbsp;▾" : "Watch Queue &nbsp;▴";
}

function toggleQueue(i){
  const item = document.getElementById("qi-"+i);
  item.classList.toggle("open");
}

render("all");
</script>
